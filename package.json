{
  "name": "studypad-ai",
  "version": "1.0.0",
  "description": "Intelligent study assistant with zero-duplication indexing system and TOON format",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:indexing": "node test-indexing-system.js",
    "benchmark": "node benchmark-indexing.js",
    "benchmark:competitive": "node competitive-benchmark.js",
    "benchmark:all": "npm run benchmark && npm run benchmark:competitive",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "keywords": [
    "education",
    "ai",
    "study",
    "pdf",
    "indexing",
    "electron",
    "toon-format",
    "inverted-index"
  ],
  "author": "김영일",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/studypad-ai.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "elasticlunr": "^0.9.5",
    "electron": "^39.2.7",
    "electron-builder": "^24.6.4",
    "electron-mock-ipc": "^0.3.14",
    "electron-rebuild": "^3.2.9",
    "flexsearch": "^0.8.212",
    "fuse.js": "^7.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "lunr": "^2.3.9"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.0",
    "dotenv": "^16.3.1",
    "pdfjs-dist": "^3.11.174"
  }
}
